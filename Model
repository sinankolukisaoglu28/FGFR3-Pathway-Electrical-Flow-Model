# ─── LIGAND FUNCTION ─────────────────────────────────────────────────────────
def ligand(t, p):
    t_local = t % p['tau']
    rise = 1.0 / (1.0 + np.exp(-2.0 * (t_local - 2.0)))
    fall = 1.0 / (1.0 + np.exp( 2.0 * (t_local - p['dt_pulse'])))
    return p['L0'] * rise * fall

# ─── ODE SYSTEM ──────────────────────────────────────────────────────────────
# State vector Y[i]:
#  0:  R          — free FGFR3
#  1:  LR         — ligand-receptor complex
#  2:  D          — active dimer
#  3:  pCbl       — phosphorylated Cbl (new)
#  4:  pFRS2      — phosphorylated FRS2
#  5:  SHP2p      — phosphorylated SHP2 (new)
#  6:  RAS_GTP    — active RAS
#  7:  pRAF       — active RAF
#  8:  ppMEK      — active MEK
#  9:  ERK        — inactive ERK
# 10:  pERK       — mono-phospho ERK
# 11:  ppERK      — dual-phospho ERK
# 12:  PLCg_act   — active PLCγ
# 13:  IP3
# 14:  Ca_i       — cytosolic Ca²⁺
# 15:  h          — IP3R inactivation gate (Li-Rinzel, corrected)
# 16:  DAG
# 17:  pPKC       — active PKC
# 18:  pGAB1
# 19:  pPI3K
# 20:  PIP3
# 21:  pAKT
# 22:  Spry       — Sprouty
# 23:  STAT1p     — phospho-STAT1 (new)
# 24:  STAT3p     — phospho-STAT3 (new)
# 25:  STAT5p     — phospho-STAT5 (new)
# 26:  STATnuc    — nuclear phospho-STAT (new, representative)
# 27:  SOCS       — SOCS protein (new)

NEQ = 28

def ode_system(t, Y, p):
    R       = max(0.0, Y[0])
    LR      = max(0.0, Y[1])
    D       = max(0.0, Y[2])
    pCbl    = max(0.0, Y[3])
    pFRS2   = max(0.0, Y[4])
    SHP2p   = max(0.0, Y[5])
    RAS_GTP = max(0.0, Y[6])
    pRAF    = max(0.0, Y[7])
    ppMEK   = max(0.0, Y[8])
    ERK     = max(0.0, Y[9])
    pERK    = max(0.0, Y[10])
    ppERK   = max(0.0, Y[11])
    PLCg_a  = max(0.0, Y[12])
    IP3     = max(0.0, Y[13])
    Ca_i    = max(1e-6, Y[14])
    h       = min(1.0, max(0.0, Y[15]))
    DAG     = max(0.0, Y[16])
    pPKC    = max(0.0, Y[17])
    pGAB1   = max(0.0, Y[18])
    pPI3K   = max(0.0, Y[19])
    PIP3    = max(0.0, Y[20])
    pAKT    = max(0.0, Y[21])
    Spry    = max(0.0, Y[22])
    STAT1p  = max(0.0, Y[23])
    STAT3p  = max(0.0, Y[24])
    STAT5p  = max(0.0, Y[25])
    STATnuc = max(0.0, Y[26])
    SOCS    = max(0.0, Y[27])

    L_t = ligand(t, p)

    # Dimer fraction — downstream activation signal
    D_frac = D / (p['R_total'] / 2.0 + 1e-9)
    D_frac = min(1.0, D_frac)

    # ─── 1. Cbl-Mediated Dynamic Endocytosis ─────────────────────────────────
    dpCbl   = p['k_cbl_on'] * D_frac * (p['Cbl_tot'] - pCbl) - p['k_cbl_off'] * pCbl
    k_intern_eff = p['k_intern0'] + p['k_cbl'] * pCbl

    J_bind   = p['k_f']     * L_t * R
    J_unbind = p['k_r']     * LR
    J_dimer  = p['k_dimer'] * LR * LR
    J_undim  = p['k_undimer'] * D
    J_intern = k_intern_eff * D

    # Basal receptor synthesis/turnover (V_synth = k_intern0 * R_total):
    # derived from thermodynamic balance so that, in the ligand-free resting
    # state, degradation = production; NO new/invented parameter is used —
    # the existing k_intern0 and R_total are reused. The free receptor also
    # decays at its own basal rate.
    V_synth = p['k_intern0'] * p['R_total']
    dR   = V_synth - p['k_intern0'] * R - J_bind + J_unbind
    dLR  =  J_bind - J_unbind - 2*J_dimer + 2*J_undim
    dD   =  J_dimer - J_undim - J_intern

    # ─── 2. FRS2 → SHP2 Amplification ────────────────────────────────────────
    dpFRS2 = p['k_frs2_on'] * D_frac * (p['FRS2_tot'] - pFRS2) - p['k_frs2_off'] * pFRS2

    # SHP2: pFRS2-dependent phosphorylation → increases GRB2 capacity
    dSHP2p = p['k_shp2_on'] * pFRS2 / (p['FRS2_tot'] + 1e-9) * (p['SHP2_tot'] - SHP2p) \
             - p['k_shp2_off'] * SHP2p

    # Effective GRB2 binding capacity (SHP2 amplification)
    GRB2_eff = p['GRB2_tot'] * (1.0 + p['alpha_shp2'] * SHP2p / (p['SHP2_tot'] + 1e-9))

    # Competitive GRB2 distribution: proportional to pFRS2, split between SOS1 and GAB1
    # GRB2_SOS1: routed to the MAPK arm; GRB2_GAB1: routed to the PI3K arm
    # Simplified: total pFRS2-bound GRB2 = GRB2_eff * pFRS2/FRS2_tot
    GRB2_bound = GRB2_eff * (pFRS2 / (p['FRS2_tot'] + 1e-9))

    # GRB2-SOS1: RAS activation (GEF mechanism)
    GRB2_SOS1 = GRB2_bound * 0.6   # 60% to SOS1, 40% to GAB1
    GRB2_GAB1 = GRB2_bound * 0.4

    # Sprouty inhibition (at the RAS step)
    inhib = 1.0 / (1.0 + Spry / (p['K_inhibit'] + 1e-9))

    dRAS_GTP = p['k_ras_on'] * (GRB2_SOS1 / (p['GRB2_tot'] + 1e-9)) * inhib \
               * (p['RAS_tot'] - RAS_GTP) - p['k_ras_off'] * RAS_GTP

    dpRAF = p['k_raf_on']  * RAS_GTP * (p['RAF_tot'] - pRAF) - p['k_raf_off'] * pRAF
    dppMEK= p['k_mek_on']  * pRAF * (p['MEK_tot'] - ppMEK)  - p['k_mek_off'] * ppMEK

    # ERK dual phosphorylation — two INDEPENDENT Michaelis-Menten reactions
    # UNIT CORRECTION: the Vmax parameters are no longer multiplied by the raw
    # enzyme concentration, but by the dimensionless "activity fraction"
    # (ppMEK/MEK_tot). This way Vmax1/Vmax2 truly have units of µM/s (the peak
    # rate reached when MEK is fully active), consistent with the
    # "fraction-based" convention used elsewhere in the model (D_frac,
    # GRB2_SOS1/GRB2_tot, etc.). This change also makes the ppERK output no
    # longer dependent on the raw numerical size of MEK_tot (which is
    # otherwise just a pool size, not a physical unit).
    MEK_frac = ppMEK / (p['MEK_tot'] + 1e-9)
    # Pharmacological MEK inhibition (e.g. Trametinib): blocks catalytic
    # output, does NOT affect RAF->pMEK phosphorylation (dppMEK above).
    MEK_active_frac = MEK_frac * (1.0 - p.get('I_MEK', 0.0))
    # Step 1: ppMEK → ERK + pERK (independent)
    v1  = p['Vmax1'] * MEK_active_frac * ERK  / (p['Km1'] + ERK  + 1e-9)
    # Step 2: ppMEK → pERK + ppERK (independent, NO substrate competition)
    v2  = p['Vmax2'] * MEK_active_frac * pERK / (p['Km2'] + pERK + 1e-9)
    # Phosphatase: ppERK → pERK (DSP phosphatase; DSP_tot is now folded into Vmax_m1)
    vm1 = p['Vmax_m1'] * ppERK / (p['Km_m1'] + ppERK + 1e-9)
    # Phosphatase: pERK → ERK
    vm2 = p['Vmax_m2'] * pERK  / (p['Km_m2'] + pERK  + 1e-9)

    dERK   = -v1 + vm2
    dpERK  =  v1 - v2 + vm1 - vm2
    dppERK =  v2 - vm1

    # ─── 3. PLCγ / IP3 / Ca²⁺ — Corrected Li-Rinzel ──────────────────────────
    dpLCg = p['k_plcg_on'] * D_frac * (p['PLCg_tot'] - PLCg_a) - p['k_plcg_off'] * PLCg_a

    v_PLC  = p['k_PLC_cat'] * PLCg_a * p['PIP2_tot'] / (p['Km_PIP2'] + p['PIP2_tot'])
    dIP3   = v_PLC - p['k_deg_IP3'] * IP3

    # Li-Rinzel IP3R — CORRECTION: dh/dt = a2*(IP3+d1)*(h_inf - h)
    # (previous erroneous form: a2*(h_inf - h*Ca_i))
    m_inf  = IP3  / (IP3  + p['d1'] + 1e-9)
    n_inf  = Ca_i / (Ca_i + p['d5'] + 1e-9)
    # Standard Li-Rinzel h-gate (original literature form):
    # Q2 = d2*(IP3+d1)/(IP3+d3);  dh/dt = a2*(Q2*(1-h) - Ca_i*h)
    # The Ca_i*h term restores CICR (calcium-induced calcium inactivation)
    # negative feedback; d1/d2/d3/a2 are all pre-existing parameters, NO new
    # parameter was added.
    Q2     = p['d2'] * (IP3 + p['d1']) / (IP3 + p['d3'] + 1e-9)
    dh     = p['a2'] * (Q2 * (1.0 - h) - Ca_i * h)

    Po     = min(1.0, max(0.0, (m_inf * n_inf * h) ** 3))

    J_IP3R  = p['k_flux']  * Po * max(0.0, p['Ca_ER_basal'] - Ca_i)
    J_SERCA = p['V_SERCA'] * Ca_i**2 / (p['K_SERCA']**2 + Ca_i**2 + 1e-9)
    J_PMCA  = p['V_PMCA']  * Ca_i    / (p['K_PMCA']    + Ca_i    + 1e-9)

    dCa_i  = J_IP3R + p['J_leak_ER'] - J_SERCA - J_PMCA

    dDAG   = p['k_dag_prod'] * v_PLC - p['k_dag_deg'] * DAG

    Ca_term  = Ca_i**2 / (p['K_PKC_Ca']**2  + Ca_i**2)
    DAG_term = DAG     / (p['K_PKC_DAG']    + DAG + 1e-9)
    dpPKC  = p['k_PKC_on'] * Ca_term * DAG_term * (p['PKC_tot'] - pPKC) \
             - p['k_PKC_off'] * pPKC

    # ─── 4. PI3K / AKT — uses GRB2_GAB1 ───────────────────────────────────────
    # ERK-mediated inhibitory feedback (mechanistic basis of bypass
    # resistance): when ppERK is high, GAB1 activation is suppressed; once
    # MEK/ERK is blocked this suppression is lifted → GAB1/PI3K/AKT increase
    # compensatorily (Yu et al. 2002).
    inhib_gab1 = 1.0 / (1.0 + ppERK / (p['K_inhibit_gab1'] + 1e-9))
    dpGAB1 = p['k_gab1_on'] * (GRB2_GAB1 / (p['GRB2_tot'] + 1e-9)) * inhib_gab1 \
              * (p['GAB1_tot'] - pGAB1) - p['k_gab1_off'] * pGAB1

    dpPI3K = p['k_pi3k_on'] * (pGAB1 / (p['GAB1_tot'] + 1e-9)) \
              * (p['PI3K_tot'] - pPI3K) - p['k_pi3k_off'] * pPI3K

    # Pharmacological PI3K inhibition (e.g. Alpelisib/BKM120): does NOT affect
    # GAB1->pPI3K formation, only blocks pPI3K's lipid-kinase catalytic output.
    PI3K_active = pPI3K * (1.0 - p.get('I_PI3K', 0.0))
    dPIP3  = p['k_pip3_prod'] * PI3K_active * (p['PIP2_tot'] - PIP3) / (p['PIP2_tot'] + 1e-9) \
             - p['k_pip3_deg'] * PIP3

    AKT_term = PIP3**2 / (p['K_AKT_PIP3']**2 + PIP3**2 + 1e-9)
    dpAKT  = p['k_akt_on'] * AKT_term * (p['AKT_tot'] - pAKT) \
             - p['k_akt_off'] * pAKT

    # ─── 5. Sprouty (Rule 3: fast phosphorylation cascade, NO mRNA delay) ────
    # Unit check: k_on_spry[µM⁻¹s⁻¹]*ppERK[µM]*(Spry_tot-Spry)[µM] = µM/s  ✓
    # (same bimolecular architecture as: dpRAF = k_raf_on*RAS_GTP*(RAF_tot-pRAF)-k_raf_off*pRAF)
    dSpry  = p['k_on_spry'] * ppERK * (p['Spry_tot'] - Spry) - p['k_off_spry'] * Spry

    # ─── 6. JAK-STAT Module (new) ─────────────────────────────────────────────
    # SOCS inhibition factor (negative feedback)
    socs_inh = 1.0 / (1.0 + SOCS * p['k_SOCS_inh'])

    # STAT1 phosphorylation: directly by FGFR3 kinase (D_frac dependent)
    dSTAT1p = p['k_stat1_on'] * D_frac * socs_inh * (p['STAT1_tot'] - STAT1p) \
              - p['k_stat1_off'] * STAT1p

    # STAT3 phosphorylation
    dSTAT3p = p['k_stat3_on'] * D_frac * socs_inh * (p['STAT3_tot'] - STAT3p) \
              - p['k_stat3_off'] * STAT3p

    # STAT5 phosphorylation
    dSTAT5p = p['k_stat5_on'] * D_frac * socs_inh * (p['STAT5_tot'] - STAT5p) \
              - p['k_stat5_off'] * STAT5p

    # Nuclear phospho-STAT (used as a representative total of STAT1p+STAT3p+STAT5p)
    STAT_total_p = STAT1p + STAT3p + STAT5p
    STAT_tot_all = p['STAT1_tot'] + p['STAT3_tot'] + p['STAT5_tot']
    dSTATnuc = p['k_import'] * STAT_total_p - p['k_export'] * STATnuc

    # SOCS: induced by pSTAT3 (target gene; main mechanism)
    # + a secondary/speculative contribution from ppERK (weighted by
    #   w_ERK_SOCS, weaker evidence strength than the STAT3 term — see
    #   parameter block note)
    dSOCS  = p['V_SOCS'] * STAT3p / (p['K_SOCS_EC50'] + STAT3p + 1e-9) \
             + p['w_ERK_SOCS'] * p['V_SOCS'] * ppERK / (p['K_SOCS_ERK'] + ppERK + 1e-9) \
             - p['k_deg_SOCS'] * SOCS

    return [
        dR, dLR, dD,
        dpCbl,
        dpFRS2, dSHP2p,
        dRAS_GTP, dpRAF, dppMEK,
        dERK, dpERK, dppERK,
        dpLCg, dIP3, dCa_i, dh,
        dDAG, dpPKC,
        dpGAB1, dpPI3K, dPIP3, dpAKT,
        dSpry,
        dSTAT1p, dSTAT3p, dSTAT5p, dSTATnuc, dSOCS,
    ]

# ─── INITIAL CONDITIONS ──────────────────────────────────────────────────────
y0 = [0.0] * NEQ
